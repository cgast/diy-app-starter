# Copy to .env and fill in.

# Required: pi needs a model provider key. pi defaults to Anthropic; set
# whichever env var matches the provider you pass via `pi --provider`.
ANTHROPIC_API_KEY=

# Optional: password-protect pi-web if you expose it beyond localhost.
PI_WEB_PASSWORD=

# Optional: where the app's "Open pi-web" links point from your browser.
# Defaults to http://localhost:30141, which is right for local docker-compose.
PI_WEB_PUBLIC_URL=
